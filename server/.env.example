PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/civicfix
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ADMIN_NAME=CivicFix Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
# Optional. For a persistent disk, set this to its mounted path, e.g. /var/data/uploads
UPLOAD_DIR=uploads
